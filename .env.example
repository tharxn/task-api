# Local development credentials. Keep these in sync with DATABASE_URL.
POSTGRES_DB=taskdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5433
# db is the Compose service name; use localhost for an app running on the host.
DATABASE_URL=postgresql://postgres:postgres@db:5432/taskdb

# Supabase Dashboard -> Project Settings -> API. Use the anon/publishable key.
# Keep real project keys only in the ignored .env file.
SUPABASE_URL=
SUPABASE_KEY=
PORT=8000
